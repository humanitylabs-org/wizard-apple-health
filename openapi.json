{
  "openapi": "3.1.0",
  "info": {
    "title": "Apple Health receiver API",
    "version": "0.1.2",
    "description": "Box-local API of the Apple Health receiver (contract wizard.health-data/1, docs/health-data-contract.md). Health Auto Export posts to /api/push with the X-Wizard-Token header. Status and day reads never include the token."
  },
  "paths": {
    "/healthz": {
      "get": {
        "summary": "Health check: version, receiving status, last push",
        "parameters": [],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/status": {
      "get": {
        "summary": "Contract status (wizard.health-data/1): source identity, status, dataset id, last push (last_sync), history span, counts, scales (no readiness; HRV is SDNN; load = Exercise minutes); plus the receiver state for the setup screen",
        "parameters": [],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/days": {
      "get": {
        "summary": "Contract read, box-only: normalized day records oldest first, paged; changed_since returns only changed days",
        "parameters": [
          {
            "name": "from",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "YYYY-MM-DD inclusive"
          },
          {
            "name": "to",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "YYYY-MM-DD inclusive"
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "days per page, default 100, max 500"
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "next_page from the previous reply"
          },
          {
            "name": "changed_since",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "cursor from an earlier reply"
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/setup": {
      "get": {
        "summary": "Setup values for this app's own screen: push path, header name and token, metrics list, Health Auto Export settings",
        "parameters": [],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/push": {
      "post": {
        "summary": "Receive one Health Auto Export JSON export (data.metrics / data.workouts). Needs X-Wizard-Token (or Authorization: Bearer). 401 wrong/missing token, 413 too large, 415 not JSON, 400 not Health Auto Export JSON. Re-sent periods replace earlier values.",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Stored"
          },
          "401": {
            "description": "Missing or wrong token"
          },
          "413": {
            "description": "Too large"
          }
        }
      }
    },
    "/api/token/rotate": {
      "post": {
        "summary": "Make a new push token; the old one stops working at once",
        "parameters": [],
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "type": "object"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/sync": {
      "post": {
        "summary": "Push-based: reports the last push (the box cannot pull from the iPhone)",
        "parameters": [],
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "type": "object"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/disconnect": {
      "post": {
        "summary": "Delete the stored copy and the token",
        "parameters": [],
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "type": "object"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/mcp": {
      "post": {
        "summary": "MCP (box-only): health_data_status, health_data_sync, health_data_days",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    }
  }
}
